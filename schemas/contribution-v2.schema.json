{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ducktate/the-librarian/blob/main/schemas/contribution-v2.schema.json",
  "title": "contribution v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "implementation",
        "deployment",
        "decision",
        "correction",
        "incident",
        "cost",
        "proposal"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "type": "string",
          "minLength": 1
        },
        "machine": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "agent",
        "session",
        "machine"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "issue": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "pull_request": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "base_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "change_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "repository",
        "commit",
        "issue",
        "pull_request",
        "base_revision",
        "change_revision"
      ],
      "additionalProperties": false
    },
    "affected_page_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]+$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "delivery_state": {
            "type": "string",
            "enum": [
              "unknown",
              "proposed",
              "implemented",
              "tested",
              "merged",
              "deployed",
              "client_qualified"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "text",
          "delivery_state",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "proposed_change": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "cost_impact": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "decision_authority": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes_event_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "draft": {
      "const": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "headline",
        "why",
        "impact"
      ],
      "additionalProperties": false
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "before": {
                  "type": "string",
                  "minLength": 1
                },
                "after": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "path",
                "before",
                "after",
                "reason",
                "evidence"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "commits": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "pull_requests": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "repository",
          "module",
          "paths",
          "commits",
          "pull_requests"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "verification": {
      "type": "object",
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "not_run",
            "passed",
            "failed",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "result",
        "evidence"
      ],
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "unknown",
            "proposed",
            "implemented",
            "tested",
            "merged",
            "deployed",
            "client_qualified"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "proposal",
                  "source_code",
                  "test",
                  "merge",
                  "deployment",
                  "client_acceptance"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "source",
              "detail"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "required": [
        "state",
        "evidence"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "none",
            "proposed",
            "accepted",
            "rejected"
          ]
        },
        "authority": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "proposal",
                  "owner_approval",
                  "authority_decision",
                  "rejection"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "source",
              "detail"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "required": [
        "state",
        "authority",
        "evidence"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "kind",
    "observed_at",
    "author",
    "context",
    "affected_page_ids",
    "claims",
    "sources",
    "proposed_change",
    "questions",
    "cost_impact",
    "decision_authority",
    "supersedes_event_id",
    "draft",
    "summary",
    "changes",
    "verification",
    "delivery",
    "decision"
  ],
  "additionalProperties": false
}
