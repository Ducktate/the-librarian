{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ducktate/the-librarian/blob/main/schemas/receipt-v2.schema.json",
  "title": "receipt v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "needs_context",
        "disputed",
        "authority_required",
        "blocked_access",
        "rejected",
        "duplicate",
        "filed",
        "published"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "affected_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "verification_notes": {
      "type": "string",
      "minLength": 1
    },
    "follow_up_owner": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "question": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "required_evidence": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "follow_up_on": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "related_event_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "published_commit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "draft": {
      "const": false
    },
    "operator": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "type": "string",
          "minLength": 1
        },
        "machine": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "agent",
        "session",
        "machine"
      ],
      "additionalProperties": false
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "sequence",
    "status",
    "recorded_at",
    "actor",
    "reason",
    "affected_paths",
    "verification_notes",
    "follow_up_owner",
    "question",
    "required_evidence",
    "follow_up_on",
    "related_event_id",
    "published_commit",
    "draft",
    "operator",
    "run_id"
  ],
  "additionalProperties": false
}
